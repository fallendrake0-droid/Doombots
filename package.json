{
    "name": "doombots",
    "version": "1.0.0",
    "private": true,
    "description": "Five lightweight Minecraft DoomBots powered by one local Ollama model.",
    "type": "module",
    "engines": {
        "node": ">=18 <23"
    },
    "dependencies": {
        "express": "^4.18.2",
        "minecraft-data": "^3.97.0",
        "minecraft-assets": "^1.16.0",
        "mineflayer": "^4.33.0",
        "mineflayer-armor-manager": "^2.0.1",
        "mineflayer-auto-eat": "^3.3.6",
        "mineflayer-collectblock": "^1.4.1",
        "mineflayer-pathfinder": "^2.4.5",
        "mineflayer-pvp": "^1.3.2",
        "open": "^10.2.0",
        "prismarine-item": "^1.15.0",
        "ses": "^1.9.1",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.7.2",
        "vec3": "^0.1.10",
        "yargs": "^17.7.2"
    },
    "overrides": {
        "canvas": "^3.1.0",
        "gl": "^8.1.6"
    },
    "scripts": {
        "postinstall": "if [ -d node_modules/prismarine-viewer ]; then patch-package; fi",
        "start": "node main.js",
        "start:lowram": "bash ./scripts/run-doombots-linux.sh",
        "check:config": "node ./scripts/check-doombots-config.mjs",
        "test:unit": "node --test tests/*.test.mjs",
        "diagnose:runtime": "node ./scripts/diagnose-runtime.mjs",
        "reinstall": "npm run clean:modules && npm ci",
        "clean:modules": "node -e \"const fs=require('fs');if(fs.existsSync('node_modules'))fs.rmSync('node_modules',{recursive:true,force:true});\""
    },
    "devDependencies": {
        "patch-package": "^8.0.0",
        "@eslint/js": "^9.13.0",
        "eslint": "^9.13.0",
        "eslint-plugin-no-floating-promise": "^2.0.0",
        "globals": "^15.11.0"
    },
    "optionalDependencies": {
        "canvas": "^3.1.0",
        "node-canvas-webgl": "^0.3.0",
        "prismarine-viewer": "^1.32.0",
        "three": "^0.128.0",
        "@anthropic-ai/sdk": "^0.17.1",
        "@cerebras/cerebras_cloud_sdk": "^1.46.0",
        "@google/genai": "^1.15.0",
        "@huggingface/inference": "^2.8.1",
        "@mistralai/mistralai": "^1.1.0",
        "groq-sdk": "^0.15.0",
        "openai": "^4.4.0",
        "replicate": "^0.29.4",
        "google-translate-api-x": "^10.7.1",
        "cheerio": "^1.0.0"
    }
}
